entred_code = "-- All the brass left. Base commander,
-- deputy, chief of staff -- gone.
-- Even Thomas Anderson, our sysadmin,
-- is gone. Nobody knows when he's back.
--
-- I need to get into the server room
-- but the door needs HIS code.
-- He's the only one with access.
--
-- I left instructions below so you
-- can find his code yourself.
--
-- The employee database is called \"db\".
-- Each record looks like this:
--   { id = \"...\", name = \"...\",
--     surname = \"...\", position = \"...\",
--     age = \"...\", need_alive = \"...\",
--     code = \"......\" }
--
-- Thomas Anderson is in there.
-- Find his record and take his code.
-- It's a 6-digit number.
--
-- Lua reminder to myself:
--  loop over a list:
--    for _, row in ipairs(db) do
--      ...
--    end
--  how to use if statement:
--    if row.name == \"NAME\" then
--      ...
--    end
-- Good luck on your shift. Stay sharp."
metadata/_custom_type_script = "uid://xv717fkc1p7t"
